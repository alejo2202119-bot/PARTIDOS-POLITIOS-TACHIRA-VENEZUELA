# ============================================================================
#  Venezuela Political Intelligence Dashboard — Environment Configuration
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ─────────────────────────── Application ───────────────────────────────────
APP_NAME="Venezuela Political Intelligence Dashboard"
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=America/Caracas
APP_DEFAULT_LOCALE=es
FRONTEND_ORIGIN=http://localhost:5173

# ─────────────────────────── Database (PostgreSQL) ─────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vpid
POSTGRES_USER=vpid_app
POSTGRES_PASSWORD=change_me_strong_password
# Full SQLAlchemy async URL (overrides the parts above if set)
DATABASE_URL=postgresql+asyncpg://vpid_app:change_me_strong_password@localhost:5432/vpid

# ─────────────────────────── Supabase ──────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server-side only, keep secret

# ─────────────────────────── Security / Auth ───────────────────────────────
JWT_SECRET_KEY=generate_a_64_char_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=bcrypt

# ─────────────────────────── Cache (Redis) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ─────────────────────────── AI / NLP Providers ────────────────────────────
# Sentiment & narrative analysis. Provider-agnostic; defaults to a local
# lexicon model when no key is present (see backend/app/services/sentiment.py).
AI_PROVIDER=local              # local | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_SENTIMENT_BATCH_SIZE=25

# ─────────────────────────── ETL / Ingestion ───────────────────────────────
ETL_SCHEDULE_CRON="0 5 * * *"  # daily 05:00 America/Caracas
ETL_USER_AGENT="VPID-OSINT-Bot/1.0 (+public-sources-only)"
ETL_REQUEST_TIMEOUT=20
ETL_MAX_ARTICLES_PER_SOURCE=200
ETL_RESPECT_ROBOTS_TXT=true

# ─────────────────────────── Reports (PDF) ─────────────────────────────────
REPORTS_STORAGE_PATH=./storage/reports
REPORT_DAILY_CRON="0 6 * * *"  # daily 06:00 — after ETL completes
REPORT_BRAND_NAME="Venezuela Political Intelligence"
REPORT_LOGO_PATH=./frontend/assets/img/logo.svg
